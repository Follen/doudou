# Only the documentation and deliverable Skill trees are versioned.
*
# Local Git worktrees belong under .worktree/<name>.
.worktree/
!.gitignore
!AGENTS.md
!README.md
!package.json
!package-lock.json
!.comet/
!.comet/**
!npm/
!npm/**
!.github/
!.github/**
!docs/
!docs/**
docs/**/__pycache__/
docs/**/*.py[cod]
!doudou/
!doudou/**
