{
  "name": "doudou",
  "version": "1.0.0",
  "private": true,
  "description": "Doudou Codex Skill and CLI for Douyin group and direct-message protocol workflows.",
  "bin": {
    "doudou": "bin/doudou.js"
  },
  "files": [
    "SKILL.md",
    "agents/",
