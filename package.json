{
  "name": "@follenfang/doudou",
  "version": "0.2.1",
  "description": "Self-describing Douyin Chrome CDP CLI (Rust) and Agent Skill.",
  "type": "module",
  "bin": {
    "doudou": "npm/bin/doudou.mjs"
  },
  "files": [
    "npm/bin/",
    "npm/lib/",
    "npm/postinstall.mjs",
    "npm/skill-manifest.json",
    "doudou/SKILL.md",
    "doudou/agents/",
    "README.md"
  ],
  "scripts": {
    "build:manifest": "node npm/scripts/build-skill-manifest.mjs",
    "check:manifest": "node npm/scripts/build-skill-manifest.mjs --check",
    "test": "node npm/scripts/run-node-tests.mjs",
    "test:pack": "node npm/scripts/verify-package.mjs",
    "check:release": "node npm/scripts/check-release-version.mjs",
    "prepack": "node npm/scripts/build-skill-manifest.mjs",
    "postinstall": "node npm/postinstall.mjs"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Follen/doudou.git"
  },
  "keywords": [
    "douyin",
    "cdp",
    "chrome",
    "rust",
    "skill",
    "cli"
  ],
  "license": "UNLICENSED"
}
