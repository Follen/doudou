# Default-deny: only source crates, docs, workflows, npm wrapper, and deliverable Skill files are versioned.
*
# Local Git worktrees belong under .worktree/<name>.
.worktree/
!.gitignore
!AGENTS.md
!README.md
!PORTING.md
!Cargo.toml
!Cargo.lock
!package.json
!.comet/
!.comet/**
!.github/
!.github/**
!crates/
!crates/**
!docs/
!docs/**
!doudou/
!doudou/**
!npm/
!npm/**
